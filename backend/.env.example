# Copy to .env and fill in real values. .env is gitignored; this file is committed.

NODE_ENV=development
PORT=3033

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=lims_dev
DB_USERNAME=postgres
DB_PASSWORD=

# JWT (HS256). Generate JWT_SECRET with: openssl rand -hex 64
JWT_SECRET=replace-with-openssl-rand-hex-64-output
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
