{
  "info": {
    "name": "LIMS — Customer",
    "description": "Customer master-data REST API. JWT Bearer auth (ADR-009). Run \"Login as admin\" first to seed {{accessToken}}. Set baseUrl + userId in environment, then run requests top-to-bottom: POST seeds {{customerID}} which subsequent requests reuse.\n\nNested children (when those APIs ship):\n  GET/POST /api/customers/:customerID/users\n  GET/POST /api/customers/:customerID/sources",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3033/api",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@lims.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerID",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "const path = pm.request.url.getPath();",
          "const isLogin = /\\/auth\\/login$/.test(path);",
          "if (!isLogin) {",
          "  const token = pm.collectionVariables.get('accessToken');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login as admin (seeds {{accessToken}})",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers?page=1&limit=20&sort=createdAt&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "sort",
              "value": "createdAt"
            },
            {
              "key": "order",
              "value": "desc"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            },
            {
              "key": "isActive",
              "value": "true",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta has total/page/limit/totalPages', () => {",
              "  pm.expect(body.meta).to.have.all.keys('total','page','limit','totalPages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create customer",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Petroleum Trading LLC\",\n  \"address\": \"Plot 12, Industrial Area, Sharjah\",\n  \"contactName\": \"Ahmed Khan\",\n  \"contactEmail\": \"ahmed@petroleum-trading.example\",\n  \"contactPhone\": \"+971-50-1234567\",\n  \"paymentTermsDays\": 30,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data.customerID present', () => pm.expect(body.data.customerID).to.be.a('string'));",
              "pm.test('audit fields populated', () => {",
              "  pm.expect(body.data.createdBy).to.be.a('string');",
              "  pm.expect(body.data.updatedBy).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('customerID', body.data.customerID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get customer by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('matches requested ID', () => {",
              "  pm.expect(body.data.customerID).to.eql(pm.variables.get('customerID'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update customer (PUT — full replace)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Petroleum Trading LLC\",\n  \"address\": \"Plot 12, Industrial Area, Sharjah\",\n  \"contactName\": \"Ahmed Khan\",\n  \"contactEmail\": \"ahmed@petroleum-trading.example\",\n  \"contactPhone\": \"+971-50-9999999\",\n  \"paymentTermsDays\": 45,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('paymentTermsDays updated', () => pm.expect(body.data.paymentTermsDays).to.eql(45));",
              "pm.test('contactPhone updated', () => pm.expect(body.data.contactPhone).to.eql('+971-50-9999999'));",
              "pm.test('updatedBy populated', () => {",
              "  pm.expect(body.data.updatedBy).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Soft delete with active children (expect 409 — prereq required)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}"
          ]
        },
        "description": "Verifies the Parent Deletion Policy: DELETE must return 409 when any non-deleted User or Source references this customer.\n\nPREREQUISITE — before running this request, insert a child row referencing {{customerID}}:\n\n  -- via SQL (until Users / Sources APIs ship):\n  INSERT INTO \"Sources\" (\"sourceID\", \"sourceTypeID\", \"customerID\", \"categoryID\", \"sourceName\", \"isDeleted\", \"isActive\", \"createdAt\", \"updatedAt\")\n  VALUES (gen_random_uuid(), '<some-source-type-uuid>', '{{customerID}}', '<some-category-uuid>', 'TEST-PREREQ', false, true, NOW(), NOW());\n\nWithout a child row, this endpoint will return 204 and the assertions below will fail (which correctly indicates the test setup was incomplete)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict (requires active child row — see request description)', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.be.false);",
              "pm.test('message references active references', () => pm.expect(body.message).to.match(/active references/i));",
              "pm.test('errors array enumerates blockers', () => {",
              "  pm.expect(body.errors).to.be.an('array').and.not.empty;",
              "  body.errors.forEach((e) => {",
              "    pm.expect(e).to.have.all.keys('field', 'message');",
              "    pm.expect(['users', 'sources']).to.include(e.field);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Soft delete customer",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));",
              "pm.test('empty body', () => pm.expect(pm.response.text()).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get deleted customer (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.be.false);",
              "pm.test('message references Customer', () => pm.expect(body.message).to.match(/Customer/i));"
            ]
          }
        }
      ]
    }
  ]
}
