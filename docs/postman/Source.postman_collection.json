      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceTypeID\": \"{{sourceTypeID}}\",\n  \"categoryID\": \"{{categoryID}}\",\n  \"sourceName\": \"MV Atlantic Star\",\n  \"equipmentName\": \"Main Engine\",\n  \"componentType\": \"Engine\",\n  \"model\": \"MAN B&W 6S60MC-C\",\n  \"make\": \"MAN\",\n  \"isActive\": true\n}"
