              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta has total/page/limit/totalPages', () => {",
              "  pm.expect(body.meta).to.have.all.keys('total','page','limit','totalPages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create source (nested)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceTypeID\": \"{{sourceTypeID}}\",\n  \"categoryID\": \"{{categoryID}}\",\n  \"sourceName\": \"MV Atlantic Star\",\n  \"equipmentName\": \"Main Engine\",\n  \"componentType\": \"Engine\",\n  \"model\": \"MAN B&W 6S60MC\",\n  \"make\": \"MAN\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}/sources",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}",
            "sources"
          ]
        },
        "description": "Nested-route create — customerID from URL, NOT body. Used by Sample Collection / Customer profile pages."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data.sourceID present', () => pm.expect(body.data.sourceID).to.be.a('string'));",
              "pm.test('customerID from URL', () => {",
              "  pm.expect(body.data.customerID).to.eql(pm.variables.get('customerID'));",
              "});",
              "pm.test('sourceTypeID matches', () => {",
              "  pm.expect(body.data.sourceTypeID).to.eql(pm.variables.get('sourceTypeID'));",
              "});",
              "pm.test('categoryID matches', () => {",
              "  pm.expect(body.data.categoryID).to.eql(pm.variables.get('categoryID'));",
              "});",
              "pm.test('audit fields populated', () => {",
              "  pm.expect(body.data.createdBy).to.be.a('string');",
              "  pm.expect(body.data.updatedBy).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('sourceID', body.data.sourceID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create with invalid sourceTypeID (expect 404)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceTypeID\": \"00000000-0000-0000-0000-000000000000\",\n  \"categoryID\": \"{{categoryID}}\",\n  \"sourceName\": \"Test Vessel\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers/{{customerID}}/sources",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers",
            "{{customerID}}",
            "sources"
          ]
        },
        "description": "Verifies explicit FK check — invalid sourceTypeID returns 404 with 'SourceType not found'."
      },
      "event": [
