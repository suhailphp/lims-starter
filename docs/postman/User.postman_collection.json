{
  "info": {
    "name": "LIMS — User",
    "description": "User CRUD endpoints (Module 02 — Phase 5).\n\nRoutes:\n  GET    /api/users                          (ADMIN/MANAGER)\n  POST   /api/users                          (ADMIN)\n  GET    /api/users/:userID                  (ADMIN/MANAGER or self)\n  PUT    /api/users/:userID                  (ADMIN, or self for firstName/lastName only)\n  DELETE /api/users/:userID                  (ADMIN; cannot delete self)\n  POST   /api/users/:userID/reset-password   (ADMIN; body { newPassword? })\n\nFlow: Run 'Login as admin' first to seed {{accessToken}}. POST seeds {{userID}} for the rest.\n\nPassword rules: min 8, max 128, ≥1 letter + ≥1 digit.\nself-update allowlist: firstName, lastName only. role/email/customerID/isActive are admin-only.\nResetting password (admin) revokes all of the target user's refresh tokens AND sets mustChangePassword=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:3033/api", "type": "string" },
    { "key": "adminEmail",    "value": "admin@lims.local",          "type": "string" },
    { "key": "adminPassword", "value": "Admin123",                  "type": "string" },
    { "key": "accessToken",   "value": "",                          "type": "string" },
    { "key": "userID",        "value": "",                          "type": "string" },
    { "key": "tempPassword",  "value": "",                          "type": "string" }
  ],
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "const path = pm.request.url.getPath();",
          "const isLogin = /\\/auth\\/login$/.test(path);",
          "if (!isLogin) {",
          "  const token = pm.collectionVariables.get('accessToken');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login as admin (seeds {{accessToken}})",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?page=1&limit=20&sort=createdAt&order=desc",
          "host": ["{{baseUrl}}"],
          "path": ["users"],
          "query": [
            { "key": "page",       "value": "1" },
            { "key": "limit",      "value": "20" },
            { "key": "sort",       "value": "createdAt" },
            { "key": "order",      "value": "desc" },
            { "key": "search",     "value": "",         "disabled": true },
            { "key": "role",       "value": "TECHNICIAN", "disabled": true },
            { "key": "isActive",   "value": "true",     "disabled": true },
            { "key": "customerID", "value": "",         "disabled": true }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta has paging fields', () => pm.expect(body.meta).to.have.all.keys('total','page','limit','totalPages'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user (TECHNICIAN)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tech\",\n  \"email\": \"postman-tech@test.local\",\n  \"password\": \"Initial123\",\n  \"role\": \"TECHNICIAN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('mustChangePassword defaults true', () => pm.expect(body.data.mustChangePassword).to.eql(true));",
              "pm.test('password not exposed', () => pm.expect(body.data).to.not.have.property('password'));",
              "pm.test('createdBy populated', () => pm.expect(body.data.createdBy).to.be.a('string'));",
              "pm.collectionVariables.set('userID', body.data.userID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user (CUSTOMER without customerID — expect 422)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Bad\",\n  \"lastName\": \"Customer\",\n  \"email\": \"bad-cust@test.local\",\n  \"password\": \"Test1234\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Role/customerID consistency rule: CUSTOMER must have customerID."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('matches userID', () => pm.expect(body.data.userID).to.eql(pm.variables.get('userID')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update user (admin — change role)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"MANAGER\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('role updated', () => pm.expect(body.data.role).to.eql('MANAGER'));",
              "pm.test('updatedBy populated', () => pm.expect(body.data.updatedBy).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset password (server-generated)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}", "reset-password"]
        },
        "description": "Empty body = server generates a 12-char temp password and returns it ONCE."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('tempPassword returned', () => pm.expect(body.data.tempPassword).to.be.a('string'));",
              "pm.test('mustChangePassword=true', () => pm.expect(body.data.mustChangePassword).to.eql(true));",
              "pm.collectionVariables.set('tempPassword', body.data.tempPassword);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset password (admin-typed)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newPassword\": \"AdminTyped9\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}", "reset-password"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returned tempPassword matches input', () => pm.expect(body.data.tempPassword).to.eql('AdminTyped9'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Soft delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));",
              "pm.test('empty body', () => pm.expect(pm.response.text()).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get deleted user (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userID}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userID}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
