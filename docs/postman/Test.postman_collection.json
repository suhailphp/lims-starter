{
  "info": {
    "name": "LIMS — Test",
    "description": "Test master-data REST API. JWT Bearer auth (ADR-009). Run \"Login as admin\" first to seed {{accessToken}}.\n\nDual-shape (same pattern as Source and Unit):\n  FLAT     LIST / CREATE → /api/tests          (used by master-data /tests page; Category included in list rows)\n  NESTED   LIST / CREATE → /api/categories/:categoryID/tests\n  ITEM     GET / PUT / DELETE → /api/tests/:testID\n\nPREREQUISITE: A valid Category must exist. Set {{categoryID}} in collection variables to a real category UUID before running (run Category collection first, then copy the categoryID).\n\nRun top-to-bottom: POST seeds {{testID}} which subsequent requests reuse.\n\nConflict-on-delete request (#8) requires a manually-inserted Method row — see its description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3033/api",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@lims.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryID",
      "value": "REPLACE_WITH_VALID_CATEGORY_UUID",
      "type": "string"
    },
    {
      "key": "testID",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "const path = pm.request.url.getPath();",
          "const isLogin = /\\/auth\\/login$/.test(path);",
          "if (!isLogin) {",
          "  const token = pm.collectionVariables.get('accessToken');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login as admin (seeds {{accessToken}})",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "List tests (flat — master-data view, all categories)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tests?page=1&limit=20&sort=createdAt&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests"
          ],
          "query": [
            { "key": "page",       "value": "1" },
            { "key": "limit",      "value": "20" },
            { "key": "sort",       "value": "createdAt" },
            { "key": "order",      "value": "desc" },
            { "key": "search",     "value": "",          "disabled": true },
            { "key": "categoryID", "value": "",          "disabled": true },
            { "key": "resultType", "value": "NUMERIC",   "disabled": true },
            { "key": "isActive",   "value": "true",      "disabled": true }
          ]
        },
        "description": "Flat list across all categories. Each row includes a `category` association ({ categoryID, name, type }) so the master-data UI can render the category name without an extra round-trip."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta has total/page/limit/totalPages', () => {",
              "  pm.expect(body.meta).to.have.all.keys('total','page','limit','totalPages');",
              "});",
              "if (body.data.length > 0) {",
              "  pm.test('row includes category association', () => {",
              "    pm.expect(body.data[0].category).to.be.an('object');",
              "    pm.expect(body.data[0].category).to.have.property('name');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create test (flat — categoryID in body)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryID\": \"{{categoryID}}\",\n  \"name\": \"Pour Point\",\n  \"decimalPlaces\": 0,\n  \"resultType\": \"NUMERIC\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests"
          ]
        },
        "description": "Flat create — used by the master-data /tests page. The `categoryID` is in the body (not URL). Backend verifies the parent category exists; returns 404 if not. Ignored: PUT does NOT accept `categoryID` (cannot move a test to a different category)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data.testID present', () => pm.expect(body.data.testID).to.be.a('string'));",
              "pm.test('categoryID matches body', () => {",
              "  pm.expect(body.data.categoryID).to.eql(pm.variables.get('categoryID'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List tests for category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryID}}/tests?page=1&limit=20&sort=createdAt&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{categoryID}}",
            "tests"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "sort",
              "value": "createdAt"
            },
            {
              "key": "order",
              "value": "desc"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            },
            {
              "key": "resultType",
              "value": "NUMERIC",
              "disabled": true
            },
            {
              "key": "isActive",
              "value": "true",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta has total/page/limit/totalPages', () => {",
              "  pm.expect(body.meta).to.have.all.keys('total','page','limit','totalPages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create test",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Flash Point\",\n  \"decimalPlaces\": 0,\n  \"resultType\": \"NUMERIC\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryID}}/tests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{categoryID}}",
            "tests"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('data.testID present', () => pm.expect(body.data.testID).to.be.a('string'));",
              "pm.test('categoryID matches', () => {",
              "  pm.expect(body.data.categoryID).to.eql(pm.variables.get('categoryID'));",
              "});",
              "pm.test('decimalPlaces correct', () => pm.expect(body.data.decimalPlaces).to.eql(0));",
              "pm.test('resultType correct', () => pm.expect(body.data.resultType).to.eql('NUMERIC'));",
              "pm.test('audit fields populated', () => {",
              "  pm.expect(body.data.createdBy).to.be.a('string');",
              "  pm.expect(body.data.updatedBy).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('testID', body.data.testID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create duplicate name in same category (case-insensitive — expect 409)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"flash point\",\n  \"decimalPlaces\": 0,\n  \"resultType\": \"NUMERIC\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryID}}/tests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{categoryID}}",
            "tests"
          ]
        },
        "description": "Verifies the (categoryID, LOWER(name)) unique partial index. 'flash point' must collide with the previously-created 'Flash Point' within the same category."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.be.false);",
              "pm.test('message indicates unique violation', () => pm.expect(body.message).to.match(/unique|duplicate/i));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get test by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tests/{{testID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('matches requested ID', () => {",
              "  pm.expect(body.data.testID).to.eql(pm.variables.get('testID'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update test (PUT — full replace)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Flash Point\",\n  \"decimalPlaces\": 0,\n  \"resultType\": \"THRESHOLD\",\n  \"isActive\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tests/{{testID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success=true', () => pm.expect(body.success).to.be.true);",
              "pm.test('resultType updated', () => pm.expect(body.data.resultType).to.eql('THRESHOLD'));",
              "pm.test('isActive flipped to false', () => pm.expect(body.data.isActive).to.be.false);",
              "pm.test('updatedBy populated', () => {",
              "  pm.expect(body.data.updatedBy).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Soft delete with active methods (expect 409 — prereq required)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tests/{{testID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testID}}"
          ]
        },
        "description": "Verifies the Parent Deletion Policy: DELETE must return 409 when any non-deleted Method references this test.\n\nPREREQUISITE — insert a child Method row before running:\n\n  INSERT INTO \"Methods\" (\"methodID\", \"testID\", \"code\", \"isDefault\", \"isDeleted\", \"isActive\", \"createdAt\", \"updatedAt\")\n  VALUES (gen_random_uuid(), '{{testID}}', 'ASTM D93-25', true, false, true, NOW(), NOW());\n\nWithout a child row this endpoint returns 204 and the assertions below fail — which correctly indicates the test setup was incomplete."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict (requires active Method row — see request description)', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.be.false);",
              "pm.test('message references active references', () => pm.expect(body.message).to.match(/active references/i));",
              "pm.test('errors array enumerates blockers', () => {",
              "  pm.expect(body.errors).to.be.an('array').and.not.empty;",
              "  body.errors.forEach((e) => {",
              "    pm.expect(e).to.have.all.keys('field', 'message');",
              "    pm.expect(['methods']).to.include(e.field);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Soft delete test",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tests/{{testID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));",
              "pm.test('empty body', () => pm.expect(pm.response.text()).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get deleted test (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tests/{{testID}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testID}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "const body = pm.response.json();",
              "pm.test('success=false', () => pm.expect(body.success).to.be.false);",
              "pm.test('message references Test', () => pm.expect(body.message).to.match(/Test/i));"
            ]
          }
        }
      ]
    }
  ]
}
