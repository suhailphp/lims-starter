{
  "info": {
    "name": "LIMS — Notifications",
    "description": "User-facing notifications fed by /api/notifications/me/*.\n\nTwo-table model:\n  Notifications              — immutable message body\n  NotificationRecipients     — per-user delivery + read/delete state\n\nRoutes:\n  GET    /api/notifications/me                  (paginated list)\n  GET    /api/notifications/me/unread-count     (bell badge)\n  PUT    /api/notifications/:id/read            (mark recipient row read)\n  PUT    /api/notifications/me/read-all         (bulk mark read)\n  DELETE /api/notifications/:id                 (per-user soft dismiss)\n\nFlow: 'Login as admin' first. Then: create a user via the Users collection — that user gets a WELCOME notification. Login as that user and inspect their feed.\n\nSee docs/modules/00-notifications.md and docs/decisions/ADR-notification-routing-architecture.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:3033/api", "type": "string" },
    { "key": "adminEmail",     "value": "admin@lims.local",          "type": "string" },
    { "key": "adminPassword",  "value": "Admin123",                  "type": "string" },
    { "key": "accessToken",    "value": "",                          "type": "string" },
    { "key": "notificationID", "value": "",                          "type": "string" }
  ],
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "const path = pm.request.url.getPath();",
          "const isLogin = /\\/auth\\/login$/.test(path);",
          "if (!isLogin) {",
          "  const token = pm.collectionVariables.get('accessToken');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login as admin (seeds {{accessToken}})",
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res?.data?.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /notifications/me (list, paginated; seeds {{notificationID}})",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/me?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "me"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "if (res?.data?.[0]?.notificationID) pm.collectionVariables.set('notificationID', res.data[0].notificationID);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /notifications/me?unreadOnly=true",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/me?unreadOnly=true&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "me"],
          "query": [
            { "key": "unreadOnly", "value": "true" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "GET /notifications/me?type=WARNING&priority=HIGH",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/me?type=WARNING&priority=HIGH",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "me"],
          "query": [
            { "key": "type", "value": "WARNING" },
            { "key": "priority", "value": "HIGH" }
          ]
        }
      }
    },
    {
      "name": "GET /notifications/me/unread-count (bell badge)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/me/unread-count",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "me", "unread-count"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test('count is a number', () => pm.expect(res.data.count).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /notifications/:id/read (mark one read)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/{{notificationID}}/read",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "{{notificationID}}", "read"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test('isRead=true', () => pm.expect(res.data.isRead).to.equal(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /notifications/me/read-all (mark all read)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/me/read-all",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "me", "read-all"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test('updated is a number', () => pm.expect(res.data.updated).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /notifications/:id (per-user soft dismiss)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notifications/{{notificationID}}",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "{{notificationID}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
