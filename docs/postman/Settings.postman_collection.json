{
  "info": {
    "name": "Settings",
    "description": "Lab-agnostic key/value settings module.\n\nRoutes (all under /api/settings):\n  GET    /public                 (unauth — login page reads this)\n  GET    /                       (ADMIN)\n  GET    /category/:category     (ADMIN)\n  GET    /:settingKey            (ADMIN)\n  PUT    /:settingKey            (ADMIN)\n  PUT    /bulk                   (ADMIN)\n  POST   /lab-logo               (ADMIN, multipart)\n\nRun the Auth → Login request first to seed `{{accessToken}}`.\n\n`isEditable=false` rows (sample_serial_format, report_number_format) reject PUT with 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:3033/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const path = pm.request.url.getPath();",
          "const isPublic = /\\/settings\\/public$/.test(path);",
          "if (!isPublic) {",
          "  const token = pm.collectionVariables.get('accessToken');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}",
          "if (!pm.request.body || pm.request.body.mode !== 'formdata') {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public (unauth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/settings/public",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "public"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('only public rows', () => {",
              "  pm.expect(body.data.every(r => r.isPublic === true)).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List All (ADMIN)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/settings", "host": ["{{baseUrl}}"], "path": ["settings"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const cats = new Set(pm.response.json().data.map(r => r.category));",
              "pm.test('contains all 4 categories', () => {",
              "  ['tenant','localization','system','workflow'].forEach(c => pm.expect(cats.has(c)).to.be.true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get By Category — tenant",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/settings/category/tenant",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "category", "tenant"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const keys = pm.response.json().data.map(r => r.settingKey);",
              "pm.test('bank settings present', () => {",
              "  ['bank_name','bank_branch','bank_account_number','bank_iban'].forEach(k => pm.expect(keys).to.include(k));",
              "});",
              "pm.test('bank settings are private (isPublic=false)', () => {",
              "  pm.response.json().data",
              "    .filter(r => r.settingKey.startsWith('bank_'))",
              "    .forEach(r => pm.expect(r.isPublic).to.be.false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get By Category — workflow",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/settings/category/workflow",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "category", "workflow"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const row = pm.response.json().data.find(r => r.settingKey === 'default_tax_rate_code');",
              "pm.test('default_tax_rate_code row exists', () => pm.expect(row).to.not.be.undefined);",
              "pm.test('default_tax_rate_code value=VAT_5', () => pm.expect(row.value).to.eql('VAT_5'));",
              "pm.test('default_tax_rate_code is private', () => pm.expect(row.isPublic).to.be.false);",
              "pm.test('default_tax_rate_code editable', () => pm.expect(row.isEditable).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Single — lab_name",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"value\": \"Acme Lab\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/settings/lab_name",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "lab_name"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('value updated', () => pm.expect(pm.response.json().data.value).to.eql('Acme Lab'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Restore lab_name",
      "request": {
        "method": "PUT",
        "header": [],
        "body": { "mode": "raw", "raw": "{ \"value\": \"Demo Company\" }" },
        "url": {
          "raw": "{{baseUrl}}/settings/lab_name",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "lab_name"]
        }
      }
    },
    {
      "name": "Bulk Update — localization",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"currency_code\": \"USD\", \"currency_symbol\": \"$\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/settings/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "bulk"]
        }
      }
    },
    {
      "name": "Bulk Restore — localization",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"currency_code\": \"USD\", \"currency_symbol\": \"$\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/settings/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "bulk"]
        }
      }
    },
    {
      "name": "Reject System-Locked Write",
      "request": {
        "method": "PUT",
        "header": [],
        "body": { "mode": "raw", "raw": "{ \"value\": \"NEW\" }" },
        "url": {
          "raw": "{{baseUrl}}/settings/sample_serial_format",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "sample_serial_format"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload Lab Logo",
      "request": {
        "method": "POST",
        "header": [],
        "description": "multipart/form-data — single field `file` (jpg/png/webp).",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/settings/lab-logo",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "lab-logo"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('attachment returned', () => pm.expect(pm.response.json().data.attachmentID).to.be.a('string'));"
            ]
          }
        }
      ]
    }
  ]
}
